#!/sbin/openrc-run
# Only needed if your greetd package didn't install /etc/init.d/greetd.
description="greetd login manager"
supervisor=supervise-daemon
command=/usr/bin/greetd
command_args="--config /etc/greetd/config.toml"
# greetd's own messages, to see why it stopped if it ever does
output_log=/var/log/greetd.log
error_log=/var/log/greetd.log
respawn_delay=2
respawn_max=5

depend() {
	need localmount
	after bootmisc elogind dbus
	use dbus
	provide display-manager
}
