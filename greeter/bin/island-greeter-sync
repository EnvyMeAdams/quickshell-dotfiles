#!/usr/bin/env python3
"""Copy your island lock-screen look to the login screen.

The login screen runs as the greetd account, which can't read your home
folder. This copies your settings (~/.config/island/settings.json) and the
files they point at (lock photo/video, desktop photos, profile picture) into
/etc/greetd/island/user/, a folder you own and greetd can read.

  island-greeter-sync            copy once
  island-greeter-sync --watch    keep copying whenever something changes
  island-greeter-sync --session "start-hyprland"   pick the default session

Run it as yourself, not with doas.
"""
import getpass
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
SRC = os.path.join(HOME, ".config/island/settings.json")
DEST = os.environ.get("ISLAND_GREETER_DIR", "/etc/greetd/island/user")
FILES = os.path.join(DEST, "files")
THUMBS = os.path.join(HOME, ".cache/island/thumbs")

# settings the login screen understands (same names as the island)
KEEP = ["surface", "accent", "outline", "shadow", "radius", "fontFamily", "pressEffect",
        "animSpeed", "use24h", "showSeconds", "userName", "lockBgKind", "lockDisplays",
        "lockAnim", "lockGlass", "glassBlur", "glassTint"]


def expand(p):
    return os.path.expanduser(p) if p else ""


def copy_in(path, used):
    """Copy one file into files/ (only if it changed) and return its new path."""
    path = expand(path)
    if not path or not os.path.isfile(path):
        return ""
    ext = os.path.splitext(path)[1].lower()
    name = hashlib.sha1(path.encode()).hexdigest()[:12] + ext
    dest = os.path.join(FILES, name)
    st = os.stat(path)
    if not (os.path.exists(dest) and os.path.getsize(dest) == st.st_size
            and int(os.path.getmtime(dest)) == int(st.st_mtime)):
        tmp = dest + ".part"
        shutil.copyfile(path, tmp)
        os.chmod(tmp, 0o644)
        os.utime(tmp, (st.st_atime, st.st_mtime))
        os.replace(tmp, dest)
    used.add(name)
    return dest


def video_frame(path):
    """A still from a video for the Wallpaper accent (island's cache first)."""
    path = expand(path)
    cached = os.path.join(THUMBS, os.path.basename(path) + ".jpg")
    if os.path.isfile(cached):
        return cached
    if shutil.which("ffmpegthumbnailer"):
        os.makedirs(THUMBS, exist_ok=True)
        subprocess.run(["ffmpegthumbnailer", "-i", path, "-o", cached, "-s", "480", "-q", "6"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if os.path.isfile(cached):
            return cached
    return ""


def sync(session=None, quiet=False):
    if not os.access(DEST, os.W_OK):
        sys.exit(f"Can't write {DEST}. Run install.sh first (it makes that folder yours).")
    try:
        with open(SRC) as f:
            s = json.load(f)
    except (OSError, ValueError) as e:
        sys.exit(f"Can't read {SRC}: {e}")

    os.makedirs(FILES, exist_ok=True)
    os.chmod(FILES, 0o755)
    used = set()
    out = {k: s[k] for k in KEEP if k in s}

    # keep the previous default session unless a new one was given
    old = {}
    try:
        with open(os.path.join(DEST, "settings.json")) as f:
            old = json.load(f)
    except (OSError, ValueError):
        pass
    out["greeterUser"] = getpass.getuser()
    out["desktop"] = old.get("desktop", "")
    out["greeterSession"] = session if session is not None else old.get("greeterSession", "")

    # lock background (photo or video)
    out["lockBg"] = copy_in(s.get("lockBg", ""), used)
    if not out["lockBg"]:
        out["lockBgKind"] = "photo"

    # desktop photos: the lock falls back to these when no lock background is set
    desk = s.get("desktop") or {}
    photos = {}
    for screen, e in desk.items():
        if isinstance(e, dict) and e.get("kind") == "photo":
            p = copy_in(e.get("path", ""), used)
            if p:
                photos[screen] = p
    out["desktopPhotos"] = photos

    # profile picture
    out["avatar"] = copy_in(s.get("avatar") or os.path.join(HOME, ".face"), used)

    # Wallpaper accent: same source as the island (first display's wallpaper)
    out["accentFile"] = ""
    if s.get("accent") == "wallpaper":
        e = desk.get("*") or next((v for v in desk.values() if isinstance(v, dict)), None)
        if e and e.get("path"):
            src = video_frame(e["path"]) if e.get("kind") == "video" else e["path"]
            out["accentFile"] = copy_in(src, used)

    # monitors + cursor for the login screen's own compositor
    sync_compositor(out)

    # drop files nothing points at anymore
    for name in os.listdir(FILES):
        if name not in used:
            try:
                os.remove(os.path.join(FILES, name))
            except OSError:
                pass

    # write atomically so the login screen never reads half a file
    tmp = os.path.join(DEST, ".settings.json.part")
    with open(tmp, "w") as f:
        json.dump(out, f, indent=2)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(DEST, "settings.json"))
    if not quiet:
        if out["lockBg"]:
            bg = f"{out['lockBgKind']} {os.path.basename(expand(s.get('lockBg')))}"
        else:
            bg = "desktop photo" if photos else "default gradient"
        print(f"Login screen updated for {out['greeterUser']} (background: {bg}).")


HYPR_FILES = [os.path.join(HOME, ".config/hypr", f) for f in
              ("config/monitors.lua", "monitors.lua", "config/environment.lua", "environment.lua")]
MANGO_CONF = os.path.join(HOME, ".config/mango/config.conf")


def write_text(name, text):
    """Write user/<name> atomically. Nothing found = keep what's there."""
    if not text:
        return
    dest = os.path.join(DEST, name)
    tmp = dest + ".part"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, dest)


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def desktop():
    """The compositor this session runs on, '' when run from a tty."""
    d = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or "hyprland" in d:
        return "hyprland"
    if os.environ.get("MANGO_INSTANCE_SIGNATURE") or "mango" in d:
        return "mango"
    return ""


def mango_files(path=MANGO_CONF, seen=None):
    """~/.config/mango/config.conf plus every file it sources, in order."""
    seen = seen if seen is not None else []
    path = os.path.realpath(os.path.expanduser(path))
    if path in seen or not os.path.isfile(path):
        return seen
    seen.append(path)
    for l in read(path).splitlines():
        # mango drops "# ..." after a space as a comment
        m = re.match(r"\s*source(?:_optional)?\s*=\s*(.+?)\s*$", re.sub(r"\s#.*", "", l))
        if m:
            p = os.path.expanduser(m.group(1))
            if not os.path.isabs(p):
                p = os.path.join(os.path.dirname(path), p)
            mango_files(p, seen)
    return seen


def hypr_monitors():
    """This machine's Hyprland monitor setup as Lua."""
    for f in HYPR_FILES[:2]:
        t = read(f)
        if "hl.monitor" in t:
            return t
    # no monitors file: build one from what Hyprland reports right now
    if desktop() == "hyprland" and shutil.which("hyprctl"):
        try:
            out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=5).stdout
            lines = []
            for m in json.loads(out):
                lines.append('hl.monitor({ output = "%s", mode = "%dx%d@%.2f", position = "%dx%d", scale = %g, transform = %d })'
                             % (m["name"], m["width"], m["height"], m["refreshRate"], m["x"], m["y"], m["scale"], m.get("transform", 0)))
            return "\n".join(lines) + "\n" if lines else ""
        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
            pass
    return ""


def cursor():
    """[(name, value)] for HYPRCURSOR_* / XCURSOR_*: Hyprland config first, then this session."""
    found = {}
    for f in HYPR_FILES[2:]:
        for m in re.finditer(r'hl\.env\(\s*"((?:HYPR|X)CURSOR_\w+)"\s*,\s*"([^"]*)"', read(f)):
            found.setdefault(m.group(1), m.group(2))
    for k in ("XCURSOR_THEME", "XCURSOR_SIZE", "HYPRCURSOR_THEME", "HYPRCURSOR_SIZE"):
        if k not in found and os.environ.get(k):
            found[k] = os.environ[k]
    return sorted(found.items())


def sync_compositor(out):
    """Monitor layout and cursor, so the login screen matches this machine's desktop."""
    write_text("monitors.lua", hypr_monitors())

    # MangoWM: monitor rules + cursor lines from your mango config (and the
    # files it pulls in with source= / source_optional=)
    keep = [l.strip() for f in mango_files() for l in read(f).splitlines()
            if re.match(r"\s*(monitor_rule|cursor_theme|cursor_size|xkb_rules_\w+)\s*=", l)]
    write_text("mango.conf", "\n".join(keep) + "\n" if keep else "")

    cur = cursor()
    write_text("cursor.lua", "".join('hl.env("%s", "%s")\n' % kv for kv in cur))
    write_text("cursor.env", "".join("%s='%s'\n" % (k, v.replace("'", "")) for k, v in cur))

    d = desktop()
    if d:
        out["desktop"] = d


def stamp():
    """Changes when settings.json or any file it points at changes."""
    parts = []
    try:
        parts.append(os.path.getmtime(SRC))
        with open(SRC) as f:
            s = json.load(f)
        paths = [s.get("lockBg"), s.get("avatar") or "~/.face"] + mango_files() + HYPR_FILES
        paths += [e.get("path") for e in (s.get("desktop") or {}).values() if isinstance(e, dict)]
        for p in paths:
            p = expand(p)
            parts.append(os.path.getmtime(p) if p and os.path.exists(p) else 0)
    except (OSError, ValueError):
        pass
    return tuple(parts)


def main():
    args = sys.argv[1:]
    if os.geteuid() == 0:
        sys.exit("Run island-greeter-sync as yourself, not as root.")
    session = None
    if "--session" in args:
        i = args.index("--session")
        session = args[i + 1] if i + 1 < len(args) else ""
    if "--watch" in args:
        last = None
        while True:
            now = stamp()
            if now != last:
                try:
                    sync(session, quiet=last is not None)
                except SystemExit as e:
                    print(e, file=sys.stderr)
                last = now
                session = None
            time.sleep(15)
    sync(session)


if __name__ == "__main__":
    main()
